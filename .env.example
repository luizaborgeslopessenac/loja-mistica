# Modelo de configuração. Copie este arquivo para ".env" e preencha com os dados reais.
# O arquivo ".env" contém dados sensíveis e é ignorado pelo Git (.gitignore).

# development exibe erros na tela; production oculta (use production na entrega)
APP_ENV=development

# Pasta da aplicação dentro do htdocs, sem barra no final (deixe vazio se rodar na raiz)
APP_BASE_URL=/loja-mistica

# Conexão com o banco MySQL/MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=loja_mistica
DB_USER=root
DB_PASS=
